# Copier ce fichier vers .env.production sur le VPS.
# Ne jamais committer le fichier rempli.

NODE_ENV=production
PORT=3000
TRUST_PROXY=1
LOG_LEVEL=info

GALATEE_DATABASE=postgres
DATABASE_URL=postgresql://galatee:CHANGE_ME@postgres:5432/galatee
GALATEE_ADMIN_TOKEN=CHANGE_ME
GALATEE_ALLOWED_ORIGIN=https://app.example.com
GALATEE_UPLOAD_DIR=/app/backend/data/uploads/menu

POSTGRES_DB=galatee
POSTGRES_USER=galatee
POSTGRES_PASSWORD=CHANGE_ME

# Laisser vide tant qu'une seule instance backend tourne.
REDIS_URL=
REDIS_KEY_PREFIX=galatee:production:
REDIS_PASSWORD=CHANGE_ME

BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Galatee
