# Backend local
# NODE_ENV : "development" en local, "production" en prod. En production le
# serveur REFUSE de demarrer si GALATEE_ADMIN_TOKEN ou GALATEE_ALLOWED_ORIGIN
# sont manquants / valent "*".
NODE_ENV=development
PORT=3000

# Token admin pour /api/admin/*. OBLIGATOIRE en production. Optionnel en dev
# (routes admin ouvertes si vide). Ne jamais commiter la valeur reelle.
GALATEE_ADMIN_TOKEN=

# CORS. En dev, "*" est tolere. En production : une origine unique (jamais "*").
GALATEE_ALLOWED_ORIGIN=http://localhost:3000

# Reverse proxy : nombre de sauts de confiance devant nous (0 = ignorer
# x-forwarded-for, 1 = derriere un seul reverse proxy comme Nginx/Caddy/
# Hostinger). Ne jamais monter plus haut sans raison explicite (spoofing IP).
TRUST_PROXY=0

# Niveau de log : debug | info | warn | error | silent. Default : "info" en
# production, "debug" en developpement.
LOG_LEVEL=

# Rate limiting (optionnel, valeurs par defaut dans server.js).
# RL_AUTH_WINDOW_MS=900000
# RL_AUTH_MAX=20
# RL_ORDER_WINDOW_MS=60000
# RL_ORDER_MAX=8
# RL_ANALYTICS_WINDOW_MS=60000
# RL_ANALYTICS_MAX=60
# RL_UPLOAD_WINDOW_MS=60000
# RL_UPLOAD_MAX=10
# RL_ADMIN_WINDOW_MS=60000
# RL_ADMIN_MAX=120

# Email transactionnel - ne jamais mettre la vraie valeur dans Git
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Galatee
