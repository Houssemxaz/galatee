# Backend local
PORT=3000
NODE_ENV=development
TRUST_PROXY=0
LOG_LEVEL=debug
GALATEE_ADMIN_TOKEN=
GALATEE_ALLOWED_ORIGIN=http://localhost:3000
GALATEE_DB_PATH=
GALATEE_UPLOAD_DIR=

# Rate limiting (laisser vide pour utiliser les valeurs par défaut)
RL_AUTH_WINDOW_MS=
RL_AUTH_MAX=
RL_ORDER_WINDOW_MS=
RL_ORDER_MAX=
RL_ANALYTICS_WINDOW_MS=
RL_ANALYTICS_MAX=
RL_UPLOAD_WINDOW_MS=
RL_UPLOAD_MAX=
RL_ADMIN_WINDOW_MS=
RL_ADMIN_MAX=

# Email transactionnel - ne jamais mettre la vraie valeur dans Git
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Galatee

# PostgreSQL - runtime optionnel (SQLite reste le défaut local)
GALATEE_DATABASE=sqlite
DATABASE_URL=
SQLITE_DATABASE_PATH=
POSTGRES_MIGRATION_CONFIRM=
POSTGRES_MIGRATION_ALLOW_EXISTING=
